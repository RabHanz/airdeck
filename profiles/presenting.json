{
  "name": "Presenting",
  "description": "Slides from the couch or the stage: OK / Back go to the next / previous slide, Home blanks the screen (hold: start the slideshow). Voice still toggles dictation. Menu: next profile.",
  "buttons": {
    "ok": {
      "action": "keys",
      "keys": "right",
      "label": "Next slide"
    },
    "back": {
      "action": "keys",
      "keys": "left",
      "label": "Previous slide"
    },
    "home": {
      "action": "keys",
      "keys": "b",
      "label": "Blank screen",
      "hold": {
        "action": "keys",
        "keys": "f5",
        "label": "Start slideshow"
      }
    },
    "home_back": {
      "action": "keys",
      "keys": "left",
      "label": "Previous slide"
    },
    "mic": {
      "action": "flow_handsfree"
    },
    "menu": {
      "action": "profile_next"
    }
  }
}
