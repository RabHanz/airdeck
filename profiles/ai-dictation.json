{
  "name": "AI dictation workflow",
  "description": "Hold Home to dictate, tap Voice for hands-free. Left/Right hop between your input spots, 1-9 jump straight to a spot, Pg+/Pg- switch desktops, OK or Play/Pause sends (Enter), Back cancels (Esc).",
  "buttons": {
    "home": {"action": "flow_ptt"},
    "home_back": {"action": "flow_ptt"},
    "mic": {"action": "flow_handsfree"},
    "right": {"action": "spot_next"},
    "left": {"action": "spot_prev"},
    "page_up": {"action": "desktop_next"},
    "page_down": {"action": "desktop_prev"},
    "play_pause": {"action": "keys", "keys": "enter"},
    "back": {"action": "flow_cancel"},
    "num_1": {"action": "spot_goto", "spot": 1},
    "num_2": {"action": "spot_goto", "spot": 2},
    "num_3": {"action": "spot_goto", "spot": 3},
    "num_4": {"action": "spot_goto", "spot": 4},
    "num_5": {"action": "spot_goto", "spot": 5},
    "num_6": {"action": "spot_goto", "spot": 6},
    "num_7": {"action": "spot_goto", "spot": 7},
    "num_8": {"action": "spot_goto", "spot": 8},
    "num_9": {"action": "spot_goto", "spot": 9},
    "ok": {"action": "keys", "keys": "enter"}
  }
}
