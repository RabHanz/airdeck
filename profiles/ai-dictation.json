{
  "name": "AI dictation workflow",
  "description": "Your main workflow. Hold Home to dictate, tap Voice for hands-free. OK sends (hold: Ctrl+Enter, double-tap: new line). Back cancels (hold: clear the box, double-tap: undo). Right/Left and 1-9 move between input spots (hold a number to save the box you're in as that spot); hold an arrow to go to the screen that way. Pg+/Pg- switch apps (hold: desktops). 0 re-pastes the last transcript (hold: move the window to the next screen). Menu: next profile.",
  "buttons": {
    "home": {
      "action": "flow_ptt"
    },
    "home_back": {
      "action": "flow_ptt"
    },
    "mic": {
      "action": "flow_handsfree"
    },
    "ok": {
      "action": "keys",
      "keys": "enter",
      "hold": {
        "action": "keys",
        "keys": "ctrl+enter"
      },
      "double": {
        "action": "keys",
        "keys": "shift+enter",
        "label": "New line"
      }
    },
    "back": {
      "action": "flow_cancel",
      "hold": {
        "action": "keys",
        "keys": "ctrl+a, backspace",
        "label": "Clear the box"
      },
      "double": {
        "action": "keys",
        "keys": "ctrl+z",
        "label": "Undo"
      }
    },
    "right": {
      "action": "spot_next",
      "hold": {
        "action": "screen_focus",
        "dir": "right"
      }
    },
    "left": {
      "action": "spot_prev",
      "hold": {
        "action": "screen_focus",
        "dir": "left"
      }
    },
    "page_up": {
      "action": "app_prev",
      "hold": {
        "action": "desktop_prev"
      }
    },
    "page_down": {
      "action": "app_next",
      "hold": {
        "action": "desktop_next"
      }
    },
    "num_1": {
      "action": "spot_goto",
      "spot": 1,
      "hold": {
        "action": "spot_capture",
        "spot": 1
      }
    },
    "num_2": {
      "action": "spot_goto",
      "spot": 2,
      "hold": {
        "action": "spot_capture",
        "spot": 2
      }
    },
    "num_3": {
      "action": "spot_goto",
      "spot": 3,
      "hold": {
        "action": "spot_capture",
        "spot": 3
      }
    },
    "num_4": {
      "action": "spot_goto",
      "spot": 4,
      "hold": {
        "action": "spot_capture",
        "spot": 4
      }
    },
    "num_5": {
      "action": "spot_goto",
      "spot": 5,
      "hold": {
        "action": "spot_capture",
        "spot": 5
      }
    },
    "num_6": {
      "action": "spot_goto",
      "spot": 6,
      "hold": {
        "action": "spot_capture",
        "spot": 6
      }
    },
    "num_7": {
      "action": "spot_goto",
      "spot": 7,
      "hold": {
        "action": "spot_capture",
        "spot": 7
      }
    },
    "num_8": {
      "action": "spot_goto",
      "spot": 8,
      "hold": {
        "action": "spot_capture",
        "spot": 8
      }
    },
    "num_9": {
      "action": "spot_goto",
      "spot": 9,
      "hold": {
        "action": "spot_capture",
        "spot": 9
      }
    },
    "num_0": {
      "action": "flow_paste_last",
      "hold": {
        "action": "window_to_screen",
        "dir": "next"
      }
    },
    "del": {
      "action": "keys",
      "keys": "ctrl+backspace"
    },
    "menu": {
      "action": "profile_next"
    },
    "up": {
      "action": "passthrough",
      "hold": {
        "action": "screen_focus",
        "dir": "up"
      }
    },
    "down": {
      "action": "passthrough",
      "hold": {
        "action": "screen_focus",
        "dir": "down"
      }
    }
  }
}
